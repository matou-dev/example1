syntax 6
namespace example1.content

genre Block : Data
field hardness : f32
field opaque : bool

genre Item : Data
field stack : u32
field label : string

genre Mob : Data
field hp : u32
field drop : item_ref
field cap : u32
field budget : u32
field y_min : u32
field y_max : u32
field drop_count : u32
field reach : f32

genre Weakspot : Data
field mult : f32
field mob : mob_ref

genre Feature : Data
field block : block_ref
field count : u32

block my_ore
  hardness = 3.0
  opaque = true

item my_gem
  stack = 64
  label = "shiny"

item my_brute_gem
  stack = 64
  label = "brute"

mob my_beast
  hp = 20
  drop = example1.content:my_gem
  cap = 4
  budget = 1
  y_min = 66
  y_max = 68
  drop_count = 1
  reach = 4.0

mob my_brute
  hp = 30
  drop = example1.content:my_brute_gem
  cap = 4
  budget = 1
  y_min = 66
  y_max = 68
  drop_count = 2
  reach = 5.0

weakspot head
  mult = 2.0
  mob = example1.content:my_beast

weakspot head
  mult = 3.0
  mob = example1.content:my_brute

feature my_vein
  block = example1.content:my_ore
  count = 8
